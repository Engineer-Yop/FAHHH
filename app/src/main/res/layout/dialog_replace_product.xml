<?xml version="1.0" encoding="utf-8"?>
<!-- "Change product" dialog: a new photo, name and price are all required. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/replace_image_box"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/product_image_bg"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp">

        <ImageView
            android:id="@+id/replace_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="New product photo"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/replace_image_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Tap to choose\na photo"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/replace_image_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="A photo is required"
        android:textColor="#C62828"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/replace_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Product name"
        android:inputType="textCapWords"
        android:maxLength="40"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/replace_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Price (₱, steps of 5)"
        android:inputType="number"
        android:maxLength="3"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="The old expiry date is cleared. Set the new product's expiry date after saving."
        android:textColor="@color/hint_color"
        android:textSize="13sp" />
</LinearLayout>
